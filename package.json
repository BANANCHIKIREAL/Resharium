{
  "name": "resharium",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Современный каталог ссылок на решения школьных заданий",
  "author": "Resharium",
  "homepage": "https://github.com/BANANCHIKIREAL/Resharium",
  "repository": {
    "type": "git",
    "url": "https://github.com/BANANCHIKIREAL/Resharium.git"
  },
  "bugs": "https://github.com/BANANCHIKIREAL/Resharium/issues",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build:web": "tsc -b && vite build",
    "build": "npm run build:web && electron-builder --win nsis",
    "build:dir": "npm run build:web && electron-builder --dir",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@material-symbols/font-400": "0.47.0",
    "@supabase/supabase-js": "2.114.0",
    "electron-updater": "^6.8.9",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "9.2.4",
    "electron": "44.1.1",
    "electron-builder": "26.15.3",
    "png-to-ico": "3.0.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wait-on": "9.0.1"
  },
  "build": {
    "appId": "ru.resharium.desktop",
    "productName": "Решариум",
    "artifactName": "Resharium-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "BANANCHIKIREAL",
        "repo": "Resharium",
        "releaseType": "release"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/app-icon.png",
      "assets/app-icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "assets/app-icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Решариум"
    }
  }
}
